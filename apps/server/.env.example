TRPG_INTENT_MODEL_ENABLED=false
# 留空时使用本地 SQLite。生产运行时设置 PostgreSQL URL；数据库迁移必须先执行验证脚本。
TRPG_DATABASE_URL=
TRPG_INTENT_MODEL_PROVIDER=deepseek
TRPG_INTENT_MINIMUM_CONFIDENCE=0.55

TRPG_NARRATOR_MODEL_ENABLED=false
TRPG_NARRATOR_MODEL_PROVIDER=deepseek
TRPG_NARRATOR_MINIMUM_CONFIDENCE=0.70
TRPG_NARRATOR_MAX_CHARACTERS=1200

TRPG_NPC_DECISION_MODEL_ENABLED=false
TRPG_NPC_DECISION_MODEL_PROVIDER=deepseek
TRPG_NPC_DECISION_MINIMUM_CONFIDENCE=0.70

# 只在本地环境设置真实密钥；不要提交、输出或传给前端。
DEEPSEEK_API_KEY=
TRPG_WEATHER_MODEL_ENABLED=false
TRPG_WEATHER_MODEL_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=900
DEEPSEEK_MAX_ATTEMPTS=2
DEEPSEEK_RETRY_DELAY_SECONDS=0.25
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high

# 可选：只覆盖叙述器；缺省时继承上面的共享设置。
DEEPSEEK_NARRATOR_MODEL=deepseek-v4-flash
DEEPSEEK_NARRATOR_MAX_TOKENS=900
DEEPSEEK_NARRATOR_THINKING_MODE=disabled
DEEPSEEK_NARRATOR_REASONING_EFFORT=high

# 可选：只覆盖 NPC 决策模型；缺省时继承共享模型设置。
DEEPSEEK_NPC_DECISION_MODEL=deepseek-v4-flash
DEEPSEEK_NPC_DECISION_MAX_TOKENS=900
